APP_ENV=development
DATABASE_URL=sqlite:///./event_discovery.db
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
POSTGRES_DB=event_discovery
POSTGRES_USER=event_discovery
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_PORT=5432

# Automated Discovery Settings
DISCOVERY_ENABLED=true
DISCOVERY_INTERVAL_MINUTES=60
DISCOVERY_REQUEST_TIMEOUT=15
DISCOVERY_MAX_PAGES_PER_SOURCE=10
DISCOVERY_MAX_CONCURRENT_SOURCES=3
DISCOVERY_USER_AGENT=TamilEventDiscoveryBot/1.0 (+https://github.com/karthi281104/Discovery_projects)

# Autonomous search (requires a self-hosted/compliant SearXNG instance)
DISCOVERY_SEARCH_ENABLED=false
DISCOVERY_SEARCH_URL=
DISCOVERY_SEARCH_INTERVAL_MINUTES=360
DISCOVERY_SEARCH_MAX_QUERIES=12
DISCOVERY_SEARCH_RESULTS_PER_QUERY=10
DISCOVERY_SEARCH_LANGUAGES=en,ta
